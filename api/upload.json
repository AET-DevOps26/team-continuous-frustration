                                    "title": "Response Health Api V1 Documents Health Get"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/documents/upload": {
            "post": {
                "tags": [
                    "default"
                ],
                "summary": "Upload a document for processing",
                "description": "Upload a PDF or TXT file and receive an upload id.",
                "operationId": "documents_upload_post_api_v1_documents_upload_post",
                "requestBody": {
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "$ref": "#/components/schemas/Body_documents_upload_post_api_v1_documents_upload_post"
                            }
                        }
                    },
                    "required": true
