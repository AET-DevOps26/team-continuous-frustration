            "Body_api_v1_genai_uploads_post_api_v1_genai_uploads_post": {
                "properties": {
                    "file": {
                        "type": "string",
                        "contentMediaType": "application/octet-stream",
                        "title": "File"
                    }
                },
                "type": "object",
                "required": [
                    "file"
                ],
                "title": "Body_api_v1_genai_uploads_post_api_v1_genai_uploads_post"
            },
            "Error": {
                "properties": {
                    "message": {
                        "type": "string",
                        "title": "Message"
                    },
                    "code": {
                        "anyOf": [
