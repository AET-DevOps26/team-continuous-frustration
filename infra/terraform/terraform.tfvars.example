project_name        = "team-continuous-frustration"
resource_group_name = "team-continuous-frustration-rg-tf"
location            = "swedencentral"
vm_name             = "team-continuous-frustration-tf"
vm_size             = "Standard_D2s_v3"
admin_username      = "azureuser"

public_key_path = "~/.ssh/team-continuous-frustration-key.pub"

# For demo you can use "*".
# For better security, replace it with your own public IP, e.g. "1.2.3.4/32".
ssh_source_address = "*"

frontend_port = "5173"
backend_port  = "8080"