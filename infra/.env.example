# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Auth service
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=900000
SESSION_EXPIRATION_MS=31536000000

CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Google OAuth (optional — app starts without these, but Google login won't work)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8088

LOGOS_API_KEY=your-logos-api-key-here
