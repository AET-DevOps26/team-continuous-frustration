# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Auth service
AUTH_SERVICE_PORT=8081
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=86400000

# Flashcard service
FLASHCARD_SERVICE_PORT=8082

# GenAI service
GENAI_SERVICE_PORT=8080

# Frontend
# Local development with Vite usually uses http://localhost:5173
# Production deployment should use relative API paths through nginx
VITE_API_URL=/api
