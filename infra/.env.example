# PostgreSQL database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Auth service
AUTH_SERVICE_PORT=8081
JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
JWT_EXPIRATION_MS=86400000

# Flashcard service
FLASHCARD_SERVICE_PORT=8082
AUTH_SERVICE_URL=http://auth-service:8081

# GenAI service
GENAI_SERVICE_PORT=8090

# API gateway
GATEWAY_PORT=8080

# Google OAuth (optional — app starts without these, but Google login won't work)
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me

# Frontend
VITE_API_BASE_URL=http://localhost:8080
