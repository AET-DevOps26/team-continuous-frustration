repo_url: "https://github.com/AET-DevOps26/team-continuous-frustration.git"
repo_dest: "/home/azureuser/team-continuous-frustration"
repo_branch: "main"

compose_file: "infra/docker-compose.azure.yml"

app_public_ip: "<PUBLIC_IP_FROM_TERRAFORM>"

env_file_content: |
  # PostgreSQL database
  POSTGRES_USER=postgres
  POSTGRES_PASSWORD=change-me

  # Auth service
  AUTH_SERVICE_PORT=8081
  JWT_SECRET=change-me-use-a-long-random-string-min-32-chars
  JWT_EXPIRATION_MS=86400000

  # Flashcard service
  FLASHCARD_SERVICE_PORT=8082

  # GenAI service
  GENAI_SERVICE_PORT=8030

  # Frontend
  VITE_API_BASE_URL=http://20.240.93.187:8081

  # Azure deployment hosts
  SERVER_HOST=<PUBLIC_IP_FROM_TERRAFORM>
  CLIENT_HOST=<PUBLIC_IP_FROM_TERRAFORM>

  # Docker image tag used by docker-compose.azure.yml
  latest=latest